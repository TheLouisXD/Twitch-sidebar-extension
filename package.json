{
  "name": "twitch-sidebar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "cross-env BROWSER_TARGET=chrome vite build",
    "build:firefox": "cross-env BROWSER_TARGET=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "pack": "node scripts/pack.js",
    "lint": "eslint .",
    "format": "prettier --write src tests manifests scripts *.config.js *.json *.md .prettierrc.json index.html",
    "format:check": "prettier --check src tests manifests scripts *.config.js *.json *.md .prettierrc.json index.html",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vite": "^8.0.10"
  }
}
